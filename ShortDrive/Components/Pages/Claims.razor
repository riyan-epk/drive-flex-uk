@page "/claims"

<SeoHead Title="Make a Claim – Temporary Motor Insurance | Drive-Flex"
         Description="How to make a claim on your Drive-Flex temporary motor insurance. Straightforward claims handling underwritten by ERS, with UK support to guide you through every step."
         Path="/claims" />

<div class="container py-5" style="max-width: 900px; min-height: 70vh;">
    <div class="text-center mb-5">
        <div class="section-label mb-2">CLAIMS</div>
        <h1 class="df-section-heading">Making a claim</h1>
        <p class="text-secondary mx-auto mt-3" style="max-width: 620px; font-size: 0.98rem; line-height: 1.6;">
            If you've had an incident while covered by a Drive-Flex policy, here's what to do. Have your
            policy number and vehicle registration to hand — it helps us deal with things quickly.
        </p>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="df-step-card">
                <div class="df-step-number">1</div>
                <h3 class="fw-bold mb-2">Get to safety</h3>
                <p class="text-secondary small mb-0">
                    Make sure everyone is safe and, if anyone is hurt or the road is blocked, call the
                    emergency services on 999 first.
                </p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="df-step-card">
                <div class="df-step-number">2</div>
                <h3 class="fw-bold mb-2">Gather details</h3>
                <p class="text-secondary small mb-0">
                    Take photos, note the other driver's details and registration, and write down what
                    happened while it's fresh.
                </p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="df-step-card">
                <div class="df-step-number">3</div>
                <h3 class="fw-bold mb-2">Report it to us</h3>
                <p class="text-secondary small mb-0">
                    Email our claims team with your policy number and what happened. We'll guide you
                    through the next steps.
                </p>
            </div>
        </div>
    </div>

    <div class="df-usecase-card" style="text-align: center;">
        <div class="df-choice-icon" style="margin-left: auto; margin-right: auto;">&#9993;</div>
        <h3 class="df-usecase-title mb-2">Report a claim by email</h3>
        <p class="df-usecase-desc mb-3">
            Include your policy number, vehicle registration and a short description of the incident.
        </p>
        <a href="mailto:supportdriveflex@gmail.com?subject=Claim%20-%20Policy%20Number" class="fw-semibold" style="color: var(--df-primary); text-decoration: none; word-break: break-all;">
            supportdriveflex@gmail.com
        </a>
    </div>

    <p class="text-center df-footer-regulatory mt-4 mb-0">
        Policies are underwritten by ERS (Syndicate 218 at Lloyd's). Drive-Flex is authorised and
        regulated by the Financial Conduct Authority (FCA Firm Reference: 612248).
    </p>
</div>
