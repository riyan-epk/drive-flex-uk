@page "/contact"

<PageTitle>Contact Us – Drive-Flex</PageTitle>

<div class="container py-5" style="max-width: 900px; min-height: 70vh;">
    <div class="text-center mb-5">
        <div class="section-label mb-2">WE'RE HERE TO HELP</div>
        <h1 class="df-section-heading">Get in touch</h1>
        <p class="text-secondary mx-auto mt-3" style="max-width: 600px; font-size: 0.98rem; line-height: 1.6;">
            Questions about a quote, your cover, or a certificate? Our UK support team is happy to help —
            the quickest way to reach us is by email.
        </p>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="df-usecase-card">
                <div class="df-choice-icon">&#9993;</div>
                <h3 class="df-usecase-title">Email support</h3>
                <p class="df-usecase-desc mb-3">
                    Send us a message any time and we'll get back to you as soon as we can, usually within one business day.
                </p>
                <a href="mailto:supportdriveflex@gmail.com" class="fw-semibold" style="color: var(--df-primary); text-decoration: none; word-break: break-all;">
                    supportdriveflex@gmail.com
                </a>
            </div>
        </div>
        <div class="col-md-6">
            <div class="df-usecase-card">
                <div class="df-choice-icon">&#128340;</div>
                <h3 class="df-usecase-title">Support hours</h3>
                <p class="df-usecase-desc mb-2">
                    Monday to Friday, 9:00am – 6:00pm (UK time).
                </p>
                <p class="df-usecase-desc mb-0">
                    Messages sent outside these hours are answered the next working day.
                </p>
            </div>
        </div>
    </div>

    <div class="df-usecase-card mt-4" style="text-align: center;">
        <h3 class="df-usecase-title mb-2">Need to make a claim?</h3>
        <p class="df-usecase-desc mb-3">
            If you need to report an incident, see our claims page for what to do and how to reach us.
        </p>
        <a href="/claims" class="df-btn-cta" style="max-width: 220px; margin: 0 auto;">
            <span>Go to claims</span><span>&rarr;</span>
        </a>
    </div>

    <p class="text-center df-footer-regulatory mt-4 mb-0">
        Drive-Flex is authorised and regulated by the Financial Conduct Authority (FCA Firm Reference: 612248).
    </p>
</div>
