@page "/about"
@page "/privacy"
@page "/terms"
@page "/contact"
@inject QuoteService QuoteSvc
@inject NavigationManager Nav

<PageTitle>@((_page?.Title ?? "Drive-Flex") + " – Drive-Flex")</PageTitle>

<div class="container py-5" style="max-width: 820px; min-height: 70vh;">
    @if (_page is null)
    {
        <div class="text-center py-5">
            <h1 class="df-section-heading mb-3">Page not found</h1>
            <a href="/" class="df-btn-cta" style="max-width: 200px; margin: 0 auto;">
                <span>Return home</span><span>&rarr;</span>
            </a>
        </div>
    }
    else if (_page.Slug == "contact")
    {
        <div class="section-label mb-2">WE'RE HERE TO HELP</div>
        <h1 class="df-section-heading mb-3">@_page.Title</h1>
        <p class="df-hero-subtitle" style="max-width: 600px;">
            Questions about a quote, your cover or a certificate? Our UK support team is happy to help —
            the quickest way to reach us is by email.
        </p>

        <div class="df-contact-grid">
            <a class="df-contact-card df-contact-card-primary" href="mailto:supportdriveflex@gmail.com">
                <div class="df-contact-icon">&#9993;</div>
                <div class="df-contact-label">Email us</div>
                <div class="df-contact-value">supportdriveflex@gmail.com</div>
                <div class="df-contact-sub">We reply within one business day &rarr;</div>
            </a>
            <div class="df-contact-card">
                <div class="df-contact-icon">&#128340;</div>
                <div class="df-contact-label">Support hours</div>
                <div class="df-contact-value">Mon–Fri, 9am – 6pm</div>
                <div class="df-contact-sub">UK time. Weekend messages answered the next working day.</div>
            </div>
        </div>

        <div class="df-contact-note">
            Need to report an incident? <a href="/claims">See how to make a claim &rarr;</a>
        </div>

        <p class="df-footer-regulatory mt-4 mb-0">
            Drive-Flex is authorised and regulated by the Financial Conduct Authority (FCA Firm Reference: 612248).
        </p>
    }
    else
    {
        <div class="section-label mb-2">DRIVE-FLEX</div>
        <h1 class="df-section-heading mb-4">@_page.Title</h1>
        <div class="df-page-content">
            @((MarkupString)_page.ContentHtml)
        </div>
        <p class="text-muted small mt-5 mb-0">Last updated @_page.UpdatedAt.ToString("dd MMM yyyy")</p>
    }
</div>

@code {
    private SitePage? _page;

    protected override async Task OnInitializedAsync()
    {
        var slug = new Uri(Nav.Uri).AbsolutePath.Trim('/').ToLowerInvariant();
        if (string.IsNullOrEmpty(slug)) slug = "about";
        _page = await QuoteSvc.GetPageAsync(slug);
    }
}
