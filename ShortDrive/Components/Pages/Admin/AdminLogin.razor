@page "/admin/login"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject AdminAuthService AdminAuth
@inject ProtectedSessionStorage SessionStore
@inject NavigationManager Nav

<PageTitle>Admin Login – Drive-Flex</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

<div class="container py-5" style="max-width: 440px;">
    <div class="p-4 bg-white rounded-4 border shadow-sm">
        <div class="text-center mb-4">
            <div class="df-brand d-inline-block mb-2" style="font-size: 1.5rem;">
                <span class="brand-drive">Drive</span><span class="brand-flex">Flex</span>
            </div>
            <h1 class="h5 fw-bold mb-1">Admin Access</h1>
            <p class="small text-muted mb-0">Enter your admin credentials to continue.</p>
        </div>

        @if (_error is not null)
        {
            <div class="alert alert-danger py-2 small" role="alert">@_error</div>
        }

        <form @onsubmit="LoginAsync" @onsubmit:preventDefault>
            <div class="mb-3">
                <label class="form-label small fw-semibold">Password</label>
                <input type="password"
                       class="form-control"
                       @bind="_password"
                       @bind:event="oninput"
                       placeholder="Enter admin password"
                       autocomplete="current-password" />
            </div>

            <button type="submit" class="btn btn-dark w-100 rounded-pill" disabled="@_loading">
                @if (_loading)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                    <span>Authenticating...</span>
                }
                else
                {
                    <span>Sign In</span>
                }
            </button>
        </form>

        <div class="text-center mt-3">
            <a href="/" class="small text-muted text-decoration-none">Back to website</a>
        </div>
    </div>
</div>

@code {
    private string _password = "";
    private string? _error;
    private bool _loading;

    protected override void OnInitialized()
    {
        if (AdminAuth.IsAuthenticated)
            Nav.NavigateTo("/admin");
    }

    private async Task LoginAsync()
    {
        _error = null;
        _loading = true;

        await Task.Delay(300);

        if (AdminAuth.IsLockedOut)
        {
            _error = "Too many failed attempts. Please wait a few minutes and try again.";
            _password = "";
            _loading = false;
            return;
        }

        if (AdminAuth.Login(_password))
        {
            try { await SessionStore.SetAsync("df_admin", true); } catch { /* storage optional */ }
            Nav.NavigateTo("/admin");
        }
        else
        {
            _error = AdminAuth.IsLockedOut
                ? "Too many failed attempts. Please wait a few minutes and try again."
                : "Invalid credentials. Please try again.";
            _password = "";
        }

        _loading = false;
    }
}
