@page "/"
@rendermode InteractiveServer
@inject NavigationManager Nav

<SeoHead Title="Temporary Car Insurance UK | 1 Hour to 28 Days | Drive-Flex"
         Description="Instant short-term car, van, bike & camper insurance in the UK. Fully comprehensive cover from 1 hour to 28 days, underwritten by ERS, certificate emailed in minutes. From £8/hr."
         Path="/" />

<div class="container">
    <section class="df-hero">
        <div class="row align-items-center g-5">
            <div class="col-lg-6 reveal">
                <div class="df-hero-badge mb-3">
                    <span class="badge-ico">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.5-3 7.6-7 9-4-1.4-7-4.5-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg>
                    </span>
                    <span>Regulated UK cover, underwritten by ERS</span>
                </div>
                <h1 class="df-hero-title">
                    Flexible cover,<br />
                    <span class="accent-word">exactly</span> when you need it.
                </h1>
                <p class="df-hero-subtitle">
                    Short-term insurance for cars, vans, bikes and campers. From one hour to twenty-eight days, fully comprehensive, underwritten by ERS and in your inbox in under a minute.
                </p>

                <div class="df-feature-chips">
                    <div class="df-feature-chip">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                        <span>From 1 Hour</span>
                    </div>
                    <div class="df-feature-chip">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="18" height="16" rx="2"/><path d="M3 9.5h18"/><path d="M8 3v3M16 3v3"/></svg>
                        <span>Up to 28 Days</span>
                    </div>
                    <div class="df-feature-chip">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.5-3 7.6-7 9-4-1.4-7-4.5-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg>
                        <span>Fully Comprehensive</span>
                    </div>
                    <div class="df-feature-chip">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M4 7l8 6 8-6"/></svg>
                        <span>Instant Cover via Email</span>
                    </div>
                </div>

                <div class="mt-4">
                    <a href="/quote" class="df-btn-cta" style="display:inline-flex; width:auto; padding:0.95rem 2rem;">
                        <span>Get a Quote</span>
                        <span>&rarr;</span>
                    </a>
                </div>
            </div>

            <div class="col-lg-6 reveal" style="--reveal-delay: 0.12s;">
                <img src="img/hero-freedom.webp" width="1200" height="917" alt="A car driving a scenic UK coastal road at sunset — drive your freedom with Drive-Flex" class="df-hero-img" fetchpriority="high" />
            </div>
        </div>
    </section>

    <section class="pb-2 reveal">
        <div class="df-eyebrow-center mb-4">
            <span class="section-label">WHY DRIVERS TRUST DRIVE-FLEX</span>
            <p class="small fw-semibold text-muted mt-2 mb-0">Fully regulated cover, underwritten at Lloyd&rsquo;s of London.</p>
        </div>
        <div class="df-trust-panel">
            <div class="df-trust-cell">
                <div class="df-trust-metric">FCA</div>
                <div class="df-trust-name">Authorised &amp; Regulated</div>
                <div class="df-trust-sub">Firm reference 612248</div>
            </div>
            <div class="df-trust-cell">
                <div class="df-trust-metric">A+</div>
                <div class="df-trust-name">Rated Underwriter</div>
                <div class="df-trust-sub">ERS — Syndicate 218 at Lloyd&rsquo;s</div>
            </div>
            <div class="df-trust-cell">
                <div class="df-trust-metric">MID</div>
                <div class="df-trust-name">Registered Cover</div>
                <div class="df-trust-sub">Police &amp; ANPR ready</div>
            </div>
            <div class="df-trust-cell">
                <div class="df-trust-metric">1&ndash;28</div>
                <div class="df-trust-name">Days of Cover</div>
                <div class="df-trust-sub">From one hour to four weeks</div>
            </div>
        </div>
    </section>

    <section class="df-section" id="quote">
        <div class="text-center mb-4 reveal">
            <div class="section-label mb-2">GET COVERED IN MINUTES</div>
            <h2 class="df-section-heading">Your price, in under a minute.</h2>
        </div>

        <div class="df-quote-panel reveal">
            <div class="df-quote-media">
                <img src="img/get-covered.webp" width="737" height="378" loading="lazy" alt="Get covered in minutes — a winding coastal road" />
            </div>
            <div class="df-quote-form">
                <div class="df-widget-header">
                    <span class="section-label" style="font-size: 0.72rem;">INSTANT QUOTE</span>
                    <span class="small text-muted" style="font-family: monospace;">@DateTime.UtcNow.Year</span>
                </div>

                <div class="mb-2">
                    <label class="form-label small fw-semibold text-muted mb-1">Vehicle</label>
                    <div class="df-tabs-row">
                        @foreach (var v in _vehicles)
                        {
                            <button type="button"
                                    class="df-tab-btn @(_selectedClass == v.Name ? "active" : "")"
                                    @onclick="() => _selectedClass = v.Name">
                                @((MarkupString)v.Icon) <span>@v.Name</span>
                            </button>
                        }
                    </div>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="form-label small fw-semibold text-muted mb-0">Registration</label>
                        <span class="small" style="color: var(--df-success); font-size: 0.75rem; font-weight: 600;">
                            DVLA verified live
                        </span>
                    </div>
                    <div class="uk-number-plate">
                        <div class="uk-plate-flag">
                            <span class="uk-code">UK</span>
                        </div>
                        <input type="text"
                               class="uk-plate-input"
                               placeholder="YOUR REG"
                               @bind="_reg"
                               @bind:event="oninput"
                               @onkeydown="HandleKeyDown"
                               maxlength="8"
                               autocomplete="off"
                               aria-label="UK Vehicle Registration Number" />
                    </div>
                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <div class="small text-danger mt-1">@_error</div>
                    }
                </div>

                <button type="button" class="df-btn-cta" @onclick="GoToQuote">
                    <span>See my price</span>
                    <span>&rarr;</span>
                </button>
            </div>
        </div>
    </section>

    <section class="df-section" id="cover">
        <div class="text-center mb-5 reveal">
            <div class="section-label mb-2">COVER FOR EVERY VEHICLE</div>
            <h2 class="df-section-heading">
                One platform.<br />
                <em>Cover for what you drive.</em>
            </h2>
            <p class="text-secondary mx-auto mt-3" style="font-size: 0.98rem; line-height: 1.6; max-width: 560px;">
                Comprehensive short-term cover, tailored to your vehicle — priced by the hour, the day or the week.
            </p>
        </div>

        <div class="df-banner-grid">
            <a class="df-banner-card reveal" href="/quote?class=Car" aria-label="Get car cover">
                <img src="img/car.webp" width="1040" height="585" loading="lazy" alt="Car insurance — quick, flexible cover for your car when you need it" />
                <span class="df-banner-cta">Get covered <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg></span>
            </a>
            <a class="df-banner-card reveal" href="/quote?class=Van" style="--reveal-delay: 0.06s;" aria-label="Get van cover">
                <img src="img/van.webp" width="1040" height="586" loading="lazy" alt="Van insurance — keep your business moving, on your terms" />
                <span class="df-banner-cta">Get covered <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg></span>
            </a>
            <a class="df-banner-card reveal" href="/quote?class=Bike" style="--reveal-delay: 0.12s;" aria-label="Get bike cover">
                <img src="img/bike.webp" width="1040" height="585" loading="lazy" alt="Bike insurance — flexible motorbike cover for your next journey" />
                <span class="df-banner-cta">Get covered <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg></span>
            </a>
            <a class="df-banner-card reveal" href="/quote" style="--reveal-delay: 0.18s;" aria-label="Get cargo cover">
                <img src="img/cargo.webp" width="1040" height="586" loading="lazy" alt="Cargo insurance — reliable cover for your goods in transit" />
                <span class="df-banner-cta">Get covered <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg></span>
            </a>
        </div>
    </section>

    <section class="df-section" id="about">
        <div class="text-center mb-5 reveal">
            <div class="section-label mb-2">MADE FOR THE WAY PEOPLE ACTUALLY DRIVE</div>
            <h2 class="df-section-heading">
                Cover for the moments<br />
                <em>an annual policy can't reach.</em>
            </h2>
            <p class="text-secondary mx-auto mt-3" style="font-size: 0.98rem; line-height: 1.6; max-width: 600px;">
                Annual insurance is great when life runs to schedule. The rest of the time, you need cover that arrives in a minute and disappears when it is done.
            </p>
        </div>

        <div class="row g-4">
            @foreach (var (uc, i) in _useCases.Select((x, i) => (x, i)))
            {
                <div class="col-md-4">
                    <div class="df-usecase-card reveal" style="--reveal-delay: @($"{(i % 3) * 0.07:0.00}")s;">
                        <div class="df-usecase-num"><span>@uc.Num</span></div>
                        <h3 class="df-usecase-title">@uc.Title</h3>
                        <p class="df-usecase-desc">@uc.Desc</p>
                    </div>
                </div>
            }
        </div>
    </section>

    <section class="df-section" id="how-it-works">
        <div class="text-center mb-4 reveal">
            <div class="section-label mb-2">HOW IT WORKS</div>
            <h2 class="df-section-heading">Three steps, from driveway to highway.</h2>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="df-step-card reveal">
                    <div class="df-step-number">1</div>
                    <h3 class="fw-bold mb-2">Enter Reg</h3>
                    <p class="text-secondary small mb-0">We look up the DVLA and MOT registers in real time to fetch vehicle details instantly.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="df-step-card reveal" style="--reveal-delay: 0.08s;">
                    <div class="df-step-number">2</div>
                    <h3 class="fw-bold mb-2">Customise</h3>
                    <p class="text-secondary small mb-0">Pick usage type, cover duration from 1 hour to 28 days, and select optional add-ons.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="df-step-card reveal" style="--reveal-delay: 0.16s;">
                    <div class="df-step-number">3</div>
                    <h3 class="fw-bold mb-2">Insured</h3>
                    <p class="text-secondary small mb-0">Checkout securely with Stripe. Your Certificate of Motor Insurance is emailed immediately.</p>
                </div>
            </div>
        </div>
    </section>
</div>

@code {
    private string _selectedClass = "Car";
    private string _reg = "";
    private string? _error;

    private record VehicleType(string Name, string Icon);
    private readonly VehicleType[] _vehicles =
    [
        new("Car", IconCar),
        new("Van", IconVan),
        new("Bike", IconBike),
        new("Camper", IconCamper)
    ];

    private record UseCase(string Num, string Title, string Desc);
    private readonly UseCase[] _useCases =
    [
        new("01", "Borrowing a Car", "Drive someone else's car without touching their no-claims bonus."),
        new("02", "Learner Practice", "Build road hours in a parent's car between driving lessons."),
        new("03", "One-off Van", "Moving house, picking up a sofa, or covering a single delivery day."),
        new("04", "Bridging the Gap", "Fill the days between annual policies. No auto-renewal, no chasing."),
        new("05", "Business Trip", "A work journey your personal policy won't stretch to cover."),
        new("06", "Test Drive", "Behind the wheel of a private sale you're seriously considering.")
    ];

    // Consistent inline SVG icon set (Lucide-style line icons) for the quote vehicle selector.
    private const string IconCar =
        "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2\"/><circle cx=\"7\" cy=\"17\" r=\"2\"/><path d=\"M9 17h6\"/><circle cx=\"17\" cy=\"17\" r=\"2\"/></svg>";
    private const string IconVan =
        "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2\"/><path d=\"M15 18H9\"/><path d=\"M19 18h2a1 1 0 0 0 1-1v-3.6a1 1 0 0 0-.2-.6l-3.5-4.4A1 1 0 0 0 17.5 8H14\"/><circle cx=\"7\" cy=\"18\" r=\"2\"/><circle cx=\"17\" cy=\"18\" r=\"2\"/></svg>";
    private const string IconBike =
        "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"5.5\" cy=\"16\" r=\"3.5\"/><circle cx=\"18.5\" cy=\"16\" r=\"3.5\"/><path d=\"M5.5 16l3.5-5h5l-2.5 5\"/><path d=\"M14 11l1.6-3H18\"/><path d=\"M9 11h4\"/><path d=\"M14.5 16l1.5-4.5\"/></svg>";
    private const string IconCamper =
        "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 16V8a2 2 0 0 1 2-2h11a4 4 0 0 1 4 4v6\"/><path d=\"M3 16h4\"/><path d=\"M11 16h9\"/><circle cx=\"9\" cy=\"16\" r=\"2\"/><rect x=\"5\" y=\"9\" width=\"4\" height=\"3.5\" rx=\"0.5\"/><path d=\"M14 6v6h6\"/></svg>";

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            GoToQuote();
    }

    private void GoToQuote()
    {
        var clean = _reg?.Trim().Replace(" ", "").ToUpperInvariant() ?? "";
        if (string.IsNullOrWhiteSpace(clean))
        {
            _error = "Please enter your UK registration plate.";
            return;
        }

        Nav.NavigateTo($"/quote?reg={Uri.EscapeDataString(clean)}&class={Uri.EscapeDataString(_selectedClass)}");
    }
}
