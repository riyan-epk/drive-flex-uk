@inject QuoteService QuoteSvc

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1D4ED8" />
    <meta name="author" content="Drive-Flex" />

    @* Site-wide social defaults. Per-page title / description / canonical / og:url are supplied
       by the <SeoHead> component on each page. *@
    <meta property="og:site_name" content="Drive-Flex" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content="https://drive-flex.uk/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Drive-Flex — flexible temporary motor insurance from 1 hour to 28 days" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://drive-flex.uk/og-image.png" />

    @* Structured data — helps Google understand the business and can enable richer listings. *@
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "InsuranceAgency",
      "name": "Drive-Flex",
      "url": "https://drive-flex.uk",
      "image": "https://drive-flex.uk/favicon.png",
      "logo": "https://drive-flex.uk/favicon.png",
      "email": "supportdriveflex@@gmail.com",
      "description": "Flexible short-term UK motor insurance for cars, vans, bikes and campers — fully comprehensive cover from 1 hour to 28 days, underwritten by ERS.",
      "areaServed": { "@@type": "Country", "name": "United Kingdom" },
      "knowsAbout": ["Temporary car insurance", "Short-term van insurance", "Learner driver insurance", "Temporary motorbike insurance", "Campervan insurance"],
      "priceRange": "From £8",
      "openingHoursSpecification": {
        "@@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        "opens": "09:00",
        "closes": "18:00"
      }
    }
    </script>
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "WebSite",
      "name": "Drive-Flex",
      "url": "https://drive-flex.uk"
    }
    </script>
    <base href="/" />
    @* Self-hosted fonts (latin subsets from Google Fonts, OFL licence). Served from our own origin
       with year-long caching, so the first paint never waits on a third-party font server.
       Inter is one variable font covering weights 400–800. *@
    <link rel="preload" href="@Assets["fonts/inter-latin.woff2"]" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="@Assets["fonts/dm-serif-display-latin.woff2"]" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="@Assets["fonts/dm-serif-display-italic-latin.woff2"]" as="font" type="font/woff2" crossorigin />
    <style>
        @@font-face {
            font-family: 'Inter'; font-style: normal; font-weight: 400 800; font-display: swap;
            src: url('@Assets["fonts/inter-latin.woff2"]') format('woff2');
            unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
        }
        @@font-face {
            font-family: 'DM Serif Display'; font-style: normal; font-weight: 400; font-display: swap;
            src: url('@Assets["fonts/dm-serif-display-latin.woff2"]') format('woff2');
            unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
        }
        @@font-face {
            font-family: 'DM Serif Display'; font-style: italic; font-weight: 400; font-display: swap;
            src: url('@Assets["fonts/dm-serif-display-italic-latin.woff2"]') format('woff2');
            unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
        }
    </style>
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["ShortDrive.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/svg+xml" href="favicon.svg?v=2" />
    @if (_analyticsId is not null)
    {
        @* Google Analytics 4 with Consent Mode v2. Everything defaults to "denied" (no cookies) until
           the visitor accepts the cookie banner; the choice is remembered in the df_consent cookie. *@
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            (function () {
                var m = document.cookie.match(/(?:^|; )df_consent=(granted|denied)/);
                var state = m && m[1] === 'granted' ? 'granted' : 'denied';
                gtag('consent', 'default', {
                    ad_storage: state, ad_user_data: state, ad_personalization: state, analytics_storage: state
                });
            })();
            gtag('set', 'ads_data_redaction', true);
            gtag('js', new Date());
            gtag('config', '@_analyticsId');
        </script>
        <script async src="https://www.googletagmanager.com/gtag/js?id=@_analyticsId"></script>
    }
    <HeadOutlet />
</head>

<body>
    <Routes />
    @if (_analyticsId is not null)
    {
        @* data-permanent keeps the banner (and its shown/hidden state) untouched by enhanced navigation. *@
        <div id="dfCookieBanner" class="df-cookie" data-permanent="df-cookie-banner"
             role="dialog" aria-labelledby="dfCookieTitle" hidden>
            <div class="df-cookie-title" id="dfCookieTitle">Cookies on Drive-Flex</div>
            <p>
                We'd like to use analytics cookies to understand how people use our site and to measure our
                adverts. They're only set if you accept. <a href="/privacy">Privacy Policy</a>
            </p>
            <div class="df-cookie-actions">
                <button type="button" class="df-cookie-btn df-cookie-btn--ghost" onclick="dfSetConsent(false)">Reject</button>
                <button type="button" class="df-cookie-btn df-cookie-btn--primary" onclick="dfSetConsent(true)">Accept</button>
            </div>
        </div>
    }
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script>
        // ── Analytics & cookie consent ─────────────────────────────────────────────
        // All helpers are safe no-ops when Google Analytics is not configured in the admin panel.
        function dfTrack(name, params) {
            if (typeof window.gtag === 'function') window.gtag('event', name, params || {});
        }
        function dfConsentChoice() {
            var m = document.cookie.match(/(?:^|; )df_consent=(granted|denied)/);
            return m ? m[1] : null;
        }
        function dfShowCookieBanner() {
            var b = document.getElementById('dfCookieBanner');
            if (!b || !b.hidden) return;
            b.hidden = false;
            requestAnimationFrame(function () { requestAnimationFrame(function () { b.classList.add('show'); }); });
        }
        function dfHideCookieBanner() {
            var b = document.getElementById('dfCookieBanner');
            if (!b) return;
            b.classList.remove('show');
            setTimeout(function () { b.hidden = true; }, 300);
        }
        function dfSyncCookieBanner() {
            if (!dfConsentChoice()) dfShowCookieBanner();
        }
        function dfSetConsent(granted) {
            var v = granted ? 'granted' : 'denied';
            document.cookie = 'df_consent=' + v + '; Max-Age=' + (60 * 60 * 24 * 180) + '; path=/; SameSite=Lax' +
                (location.protocol === 'https:' ? '; Secure' : '');
            if (typeof window.gtag === 'function') {
                window.gtag('consent', 'update', {
                    ad_storage: v, ad_user_data: v, ad_personalization: v, analytics_storage: v
                });
            }
            if (!granted) {
                // Withdrawing consent: remove any Google cookies set under a previous "Accept".
                var root = location.hostname.replace(/^www\./, '');
                document.cookie.split(';').forEach(function (c) {
                    var name = c.split('=')[0].trim();
                    if (!/^(_ga|_gid|_gcl)/.test(name)) return;
                    ['', '; domain=' + location.hostname, '; domain=.' + root].forEach(function (d) {
                        document.cookie = name + '=; Max-Age=0; path=/' + d;
                    });
                });
            }
            dfHideCookieBanner();
        }
        if (document.readyState !== 'loading') { dfSyncCookieBanner(); } else {
            document.addEventListener('DOMContentLoaded', dfSyncCookieBanner);
        }
    </script>
    <script>
        // Mobile navigation toggle. The site header lives in a server-rendered (non-interactive)
        // layout, so the hamburger is driven by plain JS rather than a Blazor click handler.
        function dfToggleMenu() {
            var nav = document.getElementById('dfMobileNav');
            var btn = document.getElementById('dfMobileToggle');
            if (!nav) return;
            var isOpen = nav.classList.toggle('open');
            if (btn) {
                btn.classList.toggle('open', isOpen);
                btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
            }
        }
        function dfCloseMenu() {
            var nav = document.getElementById('dfMobileNav');
            var btn = document.getElementById('dfMobileToggle');
            if (nav) nav.classList.remove('open');
            if (btn) {
                btn.classList.remove('open');
                btn.setAttribute('aria-expanded', 'false');
            }
        }

        // Sticky header gets a subtle solid/blur state once the page scrolls.
        function dfSyncHeader() {
            var nav = document.querySelector('.df-navbar');
            if (nav) nav.classList.toggle('scrolled', window.scrollY > 8);
        }
        window.addEventListener('scroll', dfSyncHeader, { passive: true });

        // After every enhanced page navigation: scroll to top, close the mobile menu,
        // re-sync the header state, and record the page view. Enhanced navigation doesn't
        // reload the page, so Google Analytics only sees the new page because we tell it here
        // (after the new <title> is in place, so reports show the right page name).
        (function () {
            function onNav() {
                window.scrollTo({ top: 0, left: 0 });
                dfCloseMenu();
                dfSyncHeader();
                dfSyncCookieBanner();
                dfTrack('page_view', { page_location: location.href, page_title: document.title });
            }
            function hook() {
                if (window.Blazor && Blazor.addEventListener) {
                    Blazor.addEventListener('enhancedload', onNav);
                    return true;
                }
                return false;
            }
            if (document.readyState !== 'loading') { dfSyncHeader(); } else {
                document.addEventListener('DOMContentLoaded', dfSyncHeader);
            }
            if (!hook()) {
                document.addEventListener('DOMContentLoaded', hook);
            }
        })();
    </script>
</body>

</html>

@code {
    private string? _analyticsId;

    protected override async Task OnInitializedAsync()
    {
        _analyticsId = await QuoteSvc.GetAnalyticsIdAsync();
    }
}
